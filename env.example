# Immigration API host only (no /api path).
# Client appends /api/aor-track/v1
NEXT_PUBLIC_API_URL=https://api.example.com

# Public site origin (no trailing slash) — sitemap, canonical, OG, JSON-LD
NEXT_PUBLIC_SITE_URL=<SITE_URL>

# Optional analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxx

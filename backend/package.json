{
  "name": "aor-v2-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "cases:check": "node scripts/check-cases-in-db.mjs",
    "tracker:fetch": "node scripts/fetch-tracker-json.mjs --all",
    "tracker:cases": "node scripts/extract-case-numbers.mjs",
    "tracker:dry-run": "node scripts/dry-run-milestone-sync.mjs",
    "tracker:sync": "node scripts/sync-milestones.mjs",
    "tracker:seed": "node scripts/seed-from-tracker-json.mjs",
    "tracker:seed:apply": "node scripts/seed-from-tracker-json.mjs --apply",
    "db:migrate:dump": "node scripts/migrate-mongodb.mjs dump",
    "db:migrate:restore": "node scripts/migrate-mongodb.mjs restore",
    "db:migrate:copy": "node scripts/migrate-mongodb.mjs copy",
    "db:migrate:verify": "node scripts/migrate-mongodb.mjs verify"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
